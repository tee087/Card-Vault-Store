# Telegram Bot Configuration (REQUIRED)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_ADMIN_ID=your_admin_chat_id

# Optional shared secret to secure requests from your Vercel site
SECRET_KEY=a_random_secure_string_here

# Optional: restrict which origins can call this API
ALLOWED_ORIGIN=https://carding-bank-logs-linkable-ccs.vercel.app

# Port (Render sets this automatically)
PORT=3000
